# Copia questo file in ".env" (stessa cartella di package.json) e sostituisci i valori.
# Il file .env NON va mai committato né condiviso pubblicamente.

PORT=3000

# Opzione 1 - MongoDB locale
# MONGODB_URI=mongodb://127.0.0.1:27017/showtracker
# Opzione 2 - MongoDB Atlas (stringa fornita dal gruppo; /showtracker = nome del database)
MONGODB_URI=mongodb+srv://UTENTE:PASSWORD@NOME-CLUSTER.mongodb.net/showtracker?retryWrites=true&w=majority

# Una stringa lunga e casuale: serve a firmare i token JWT
JWT_SECRET=cambia-questa-chiave-con-una-stringa-lunga-e-casuale
JWT_EXPIRE=1d

# "API Read Access Token" (Bearer, molto lungo) da themoviedb.org > Impostazioni > API
TMDB_TOKEN=incolla-qui-il-token-bearer-di-tmdb
